{
  "expo": {
    "name": "Vintrace",
    "slug": "vintrace-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.vintrace.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Vintrace shows and organizes your photo library on-device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Vintrace shows and organizes your photo library on-device.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-video",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Vintrace uses Face ID to unlock your Hidden album."
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
