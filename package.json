          "jpx",
          "ppm",
          "pgm",
          "pbm",
          "pnm",
          "tga",
          "dds",
          "psd",
          "dng",
          "raw",
          "arw",
          "cr2",
          "cr3",
          "nef",
          "nrw",
          "orf",
          "raf",
