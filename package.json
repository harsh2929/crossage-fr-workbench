      "packageCategory": "graphics",
      "packageName": "vintrace",
      "recommends": []
    },
    "rpm": {
      "artifactName": "${name}-${version}.${arch}.${ext}",
      "compression": "gzip",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret"
      ],
      "packageCategory": "Graphics",
      "packageName": "vintrace"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
