          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "desktop/assets/icon.ico",
      "forceCodeSigning": true,
      "signExts": [
        ".exe"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Graphics;Photography;",
      "description": "Private local face recognition and photo intelligence workbench.",
      "desktop": {
        "entry": {
          "Name": "Vintrace",
          "Keywords": "photos;images;faces;organize;privacy;",
          "StartupWMClass": "Vintrace",
          "Terminal": "false",
          "Type": "Application"
        }
      },
      "executableName": "vintrace",
      "icon": "desktop/assets/icon.png",
      "maintainer": "Vintrace",
      "synopsis": "Private local photo intelligence",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "vendor": "Vintrace"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "compression": "zstd"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "compression": "xz",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
