        ]
      },
      {
        "from": "report.md",
        "to": "report.md"
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "desktop/assets/icon.icns",
      "minimumSystemVersion": "14.0",
      "forceCodeSigning": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Vintrace uses the camera to capture local review photos for face matching.",
        "NSLocalNetworkUsageDescription": "Vintrace uses your private network only when you enable encrypted device-to-device catalog sync.",
        "NSBonjourServices": [
          "_vintrace-sync._tcp"
        ]
      },
      "hardenedRuntime": true,
      "notarize": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/assets/entitlements.mac.plist",
      "entitlementsInherit": "desktop/assets/entitlements.mac.plist",
      "target": [
