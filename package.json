          "mov",
          "mp4",
          "m4v",
          "avi",
          "mkv",
          "webm",
          "hevc",
          "3gp",
          "3g2",
          "mts",
          "m2ts",
          "qt",
          "mpeg",
          "mpg",
          "wmv",
          "flv",
          "asf",
          "ogv",
          "dv"
        ],
        "role": "Viewer"
      }
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend",
        "filter": [
          "crossage-backend",
          "crossage-backend.exe",
          "crossage-backend/**/*"
        ]
      },
      {
        "from": "crossage_fr",
        "to": "crossage_fr",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
