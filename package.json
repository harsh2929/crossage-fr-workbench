  "build": {
    "appId": "com.vintrace.workbench",
    "productName": "Vintrace",
    "publish": [
      {
        "provider": "github",
        "owner": "harsh2929",
        "repo": "crossage-fr-workbench"
      }
    ],
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "desktop/**/*",
      "package.json"
